# ---- secrets: NEVER commit these ----
.env
.env.local
# Any other copy of .env (backups like .env.local-backup-2026-09-28) holds the
# same credentials. An example file with no secrets may still be committed.
.env.*
!.env.example
*.pem
*.key

# ---- python virtual env & caches ----
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- crawl outputs / generated data (large, regenerated locally) ----
output/
outputs/
downloads/
logs/
*.log
html_output_all/
html_output_common/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# build artefacts
__pycache__/
*.pyc
benchmarks/runs/

# ---- root scratch, untracked 2026-08-26 --------------------------------------
# One-off scripts, generated artefacts and an unpacked .pptx. They still exist
# locally; they are simply not the repo's business. Anything genuinely shared
# belongs in a package (crawler/, jobs/, scripts/, tools/), not at the root.
#
# crawl_to_excel.py and sama_finance_sector_to_excel.py are DELIBERATELY still
# tracked: crawler/sama_rulebook_crawler.py and two tests import them, and a
# fresh clone would fail without them.
/*.py
!/crawl_to_excel.py
!/sama_finance_sector_to_excel.py
/*.sql
/*.json
/*.pkl
/*.xlsx
/*.pptx
pptx_extract/
